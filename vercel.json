{
  "rewrites": [
    {
      "source": "/auto",
      "destination": "/auto.html"
    },
    {
      "source": "/info",
      "destination": "/index.html"
    },
    {
      "source": "/manual",
      "destination": "/manual.html"
    },
    {
      "source": "/redeem",
      "destination": "/redeem.html"
    },
    {
      "source": "/api/discord-avatar",
      "destination": "/api/discord-tools/avatar"
    },
    {
      "source": "/api/discord-user",
      "destination": "/api/discord-tools/user"
    },
    {
      "source": "/api/discord-interactions",
      "destination": "/api/discord-tools/interactions"
    },
    {
      "source": "/api/kingshot-admin-data",
      "destination": "/api/admin-tools/data"
    },
    {
      "source": "/api/kingshot-admin-login",
      "destination": "/api/admin-tools/login"
    },
    {
      "source": "/api/kingshot-health",
      "destination": "/api/ops-tools/health"
    },
    {
      "source": "/api/kingshot-support",
      "destination": "/api/ops-tools/support"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/message",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.discordapp.com https://is1-ssl.mzstatic.com https://*.mzstatic.com; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:; frame-src 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/kingshot-auto.js": {
      "maxDuration": 300
    }
  }
}
