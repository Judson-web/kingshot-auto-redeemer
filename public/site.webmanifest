{
  "name": "Kingshot Auto Redeemer",
  "short_name": "Kingshot",
  "description": "Your Kingshot redemption and alliance workspace, built for web and installed devices.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#0b0d10",
  "theme_color": "#0b0d10",
  "categories": [
    "utilities",
    "games"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.svg?v=12",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.svg?v=12",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.svg?v=12",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.svg?v=12",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Auto Redeem",
      "short_name": "Auto Redeem",
      "description": "Register Kingshot Player IDs for automatic gift-code redemption.",
      "url": "/auto",
      "icons": [
        {
          "src": "/icons/icon-192.svg?v=12",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Manual Redeem",
      "short_name": "Manual Redeem",
      "description": "Redeem a Kingshot gift code manually.",
      "url": "/manual",
      "icons": [
        {
          "src": "/icons/icon-192.svg?v=12",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
