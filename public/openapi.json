{
  "openapi": "3.1.0",
  "info": {
    "title": "Kingshot Auto Redeemer Developer API",
    "version": "3.0.0",
    "description": "V3 is the supported developer API for player lookup and manual redemption. V1 routes are deprecated and retained temporarily for migration; new and existing integrations should migrate to V3. Use only with authorized player accounts. Documented public JSON responses include a top-level dev attribution object with maintainer name and Discord contact.",
    "termsOfService": "https://kingshot-autoredeemer.vercel.app/terms?service=kingshot-auto",
    "contact": {
      "name": "Judson",
      "url": "https://discord.com/users/871756466900598815",
      "x-discord-handle": "@judson00713"
    }
  },
  "servers": [
    {
      "url": "https://kingshot-autoredeemer.vercel.app"
    }
  ],
  "tags": [
    {
      "name": "Developer API",
      "description": "Bearer-key protected integration endpoints."
    },
    {
      "name": "Enrollment",
      "description": "Public website enrollment flow, separate from developer API key access."
    }
  ],
  "paths": {
    "/api/v1/player": {
      "get": {
        "tags": [
          "Developer API"
        ],
        "summary": "Look up a player profile",
        "description": "Legacy V1 route retained for compatibility. New integrations should use GET /api/v3/players/{playerId}.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Numeric Kingshot Player ID (5–20 digits).",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{5,20}$",
              "minLength": 5,
              "maxLength": 20
            },
            "example": "43180889"
          }
        ],
        "responses": {
          "200": {
            "description": "Lookup completed; V1 is deprecated, and responses include deprecation headers pointing to V3 JSON responses include the top-level dev attribution object.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerLookupResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid Player ID JSON responses include the top-level dev attribution object."
          },
          "401": {
            "description": "Missing, invalid, or revoked API key JSON responses include the top-level dev attribution object."
          },
          "404": {
            "description": "Player not found JSON responses include the top-level dev attribution object."
          },
          "429": {
            "description": "Rate limit or quota exceeded JSON responses include the top-level dev attribution object."
          },
          "502": {
            "description": "Upstream provider unavailable JSON responses include the top-level dev attribution object."
          }
        },
        "deprecated": true
      }
    },
    "/api/v1/redeem": {
      "post": {
        "tags": [
          "Developer API"
        ],
        "summary": "Manually redeem a gift code",
        "description": "Legacy V1 route retained for compatibility. New integrations should use POST /api/v3/redemptions. Inspect the response body; HTTP success alone does not guarantee rewards were granted.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualRedemptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request processed; inspect operation result in response body; V1 is deprecated, and responses include deprecation headers pointing to V3 JSON responses include the top-level dev attribution object."
          },
          "400": {
            "description": "Invalid request fields JSON responses include the top-level dev attribution object."
          },
          "401": {
            "description": "Missing, invalid, or revoked API key JSON responses include the top-level dev attribution object."
          },
          "429": {
            "description": "Rate limit or quota exceeded JSON responses include the top-level dev attribution object."
          },
          "502": {
            "description": "Upstream provider unavailable JSON responses include the top-level dev attribution object."
          }
        },
        "deprecated": true
      }
    },
    "/api/kingshot-register": {
      "post": {
        "tags": [
          "Enrollment"
        ],
        "summary": "Enroll a player in automatic redemption",
        "description": "Public website enrollment route, separate from the Bearer-key developer API. Does not start or control the worker and does not guarantee code validity.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Enrollment request processed JSON responses include the top-level dev attribution object."
          },
          "400": {
            "description": "Invalid request fields JSON responses include the top-level dev attribution object."
          },
          "429": {
            "description": "Rate limited JSON responses include the top-level dev attribution object."
          }
        }
      }
    },
    "/api/v3/players/{playerId}": {
      "get": {
        "tags": [
          "Developer API"
        ],
        "operationId": "getPlayerV3",
        "summary": "Look up a player profile (V3)",
        "description": "Returns a normalized player profile plus provider-cache freshness signals and database-backed quota metadata. Requires an active developer Bearer key.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "description": "Numeric Kingshot Player ID (5–20 digits).",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{5,20}$",
              "minLength": 5,
              "maxLength": 20
            },
            "example": "43180889"
          }
        ],
        "responses": {
          "200": {
            "description": "Player lookup completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3PlayerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid Player ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Player not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream provider unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Authorization or provider configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Upstream request timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v3/redemptions": {
      "post": {
        "tags": [
          "Developer API"
        ],
        "operationId": "createRedemptionV3",
        "summary": "Submit a manual gift-code redemption (V3)",
        "description": "Submits one player/code/kingdom combination. A completed in-game rejection may return HTTP 200; inspect data.ok and data.status. Do not blindly retry an ambiguous timeout. Optional Idempotency-Key provides durable 24-hour replay protection for matching bodies; conflicting reuse returns 409. This cannot guarantee exactly-once upstream execution.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiV3RedemptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redemption operation completed; inspect data for the in-game outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3RedemptionResponse"
                }
              }
            },
            "headers": {
              "Idempotency-Replayed": {
                "description": "True when a stored outcome is replayed",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key conflict or request still processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream provider unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Authorization or provider configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Upstream request timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV3ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional durable replay protection for 24 hours; conflicting reuse returns 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            },
            "example": "redeem-43180889-example-001"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key",
        "description": "Create a key from the developer portal. Keep it secret and send it only over HTTPS."
      }
    },
    "schemas": {
      "PlayerLookupResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "playerId": {
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kingdomId": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              "power": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "townCenterLevel": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "avatarUrl": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "allianceName": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Current alliance name, when available."
              },
              "allianceTag": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Current alliance abbreviation/tag, when available."
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "remaining": {
                "type": "integer"
              },
              "dailyRemaining": {
                "type": "integer"
              }
            }
          },
          "dev": {
            "$ref": "#/components/schemas/DeveloperAttribution"
          }
        },
        "required": [
          "data",
          "dev"
        ]
      },
      "ManualRedemptionRequest": {
        "type": "object",
        "required": [
          "playerId",
          "code",
          "kid"
        ],
        "properties": {
          "playerId": {
            "type": "string",
            "pattern": "^[0-9]{5,20}$"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kid": {
            "type": "string",
            "pattern": "^[0-9]{1,10}$"
          }
        },
        "additionalProperties": false
      },
      "EnrollmentRequest": {
        "type": "object",
        "required": [
          "playerId"
        ],
        "properties": {
          "playerId": {
            "type": "string",
            "pattern": "^[0-9]{5,20}$"
          },
          "kingdomId": {
            "type": "string",
            "pattern": "^[0-9]{1,10}$"
          },
          "playerName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      },
      "ApiV3RateLimit": {
        "type": "object",
        "properties": {
          "perMinuteLimit": {
            "type": "integer"
          },
          "perMinuteRemaining": {
            "type": "integer"
          },
          "perDayLimit": {
            "type": "integer"
          },
          "perDayRemaining": {
            "type": "integer"
          },
          "resetAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      },
      "ApiV3Meta": {
        "type": "object",
        "required": [
          "apiVersion",
          "requestId",
          "timestamp"
        ],
        "properties": {
          "apiVersion": {
            "type": "string",
            "const": "3"
          },
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "fetchedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "stale": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "providerFresh": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "providerAgeSeconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "rateLimit": {
            "$ref": "#/components/schemas/ApiV3RateLimit"
          },
          "reason": {
            "type": "string"
          },
          "resetAt": {
            "type": "string",
            "format": "date-time"
          },
          "documentation": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "ApiV3ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "meta",
          "dev"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "meta": {
            "$ref": "#/components/schemas/ApiV3Meta"
          },
          "dev": {
            "$ref": "#/components/schemas/DeveloperAttribution"
          }
        },
        "additionalProperties": false
      },
      "ApiV3PlayerResponse": {
        "type": "object",
        "required": [
          "data",
          "meta",
          "dev"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "playerId",
              "name",
              "kingdomId",
              "power",
              "townCenterLevel",
              "avatarUrl"
            ],
            "properties": {
              "playerId": {
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kingdomId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "power": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "townCenterLevel": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "avatarUrl": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "allianceName": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Current alliance name, when available."
              },
              "allianceTag": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Current alliance abbreviation/tag, when available."
              }
            },
            "additionalProperties": false
          },
          "meta": {
            "$ref": "#/components/schemas/ApiV3Meta"
          },
          "dev": {
            "$ref": "#/components/schemas/DeveloperAttribution"
          }
        },
        "additionalProperties": false
      },
      "ApiV3RedemptionRequest": {
        "type": "object",
        "required": [
          "playerId",
          "code",
          "kid"
        ],
        "properties": {
          "playerId": {
            "type": "string",
            "pattern": "^[0-9]{5,20}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "minLength": 1,
            "maxLength": 64
          },
          "kid": {
            "type": "string",
            "pattern": "^[0-9]{1,10}$"
          }
        },
        "additionalProperties": false
      },
      "ApiV3RedemptionResponse": {
        "type": "object",
        "required": [
          "data",
          "meta",
          "dev"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "ok",
              "status",
              "statusLabel",
              "message",
              "errorCategory",
              "errCode"
            ],
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "status": {
                "type": "string"
              },
              "statusLabel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": "string"
              },
              "errorCategory": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "errCode": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "meta": {
            "$ref": "#/components/schemas/ApiV3Meta"
          },
          "dev": {
            "$ref": "#/components/schemas/DeveloperAttribution"
          }
        },
        "additionalProperties": false
      },
      "DeveloperAttribution": {
        "type": "object",
        "required": [
          "name",
          "discord",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "const": "Judson",
            "description": "Project developer and maintainer."
          },
          "discord": {
            "type": "string",
            "const": "@judson00713",
            "description": "Public Discord handle."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "const": "https://discord.com/users/871756466900598815",
            "description": "Direct Discord profile URL."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "externalDocs": {
    "description": "Interactive developer documentation",
    "url": "https://kingshot-autoredeemer.vercel.app/developer"
  }
}
