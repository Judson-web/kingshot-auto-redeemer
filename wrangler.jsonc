{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kingshot-autoredeemer-edge",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_URL": "https://wocxvtptqapietlteshr.supabase.co",
    "SUPABASE_WRITE_MODE": "disabled"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vpc_networks": [
    {
      "binding": "EGRESS",
      "network_id": "cf1:network",
      "remote": true
    }
  ]
}
