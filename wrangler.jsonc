{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kingshot-autoredeemer-edge",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_URL": "https://wocxvtptqapietlteshr.supabase.co",
    "SECONDARY_SUPABASE_URL": "https://sfntksruilzncahytxve.supabase.co",
    "SECONDARY_REDEMPTION_ENABLED": "true",
    "PUBLIC_APP_URL": "https://app.ks-redeemer.workers.dev",
    "SUPABASE_WRITE_MODE": "enabled",
    "KINGDOM_AUTO_CHECK_ENABLED": "false"
  },
  "services": [
    {
      "binding": "SHARD_WORKER",
      "service": "kingshot-autoredeemer-shard",
      "remote": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  }
}
